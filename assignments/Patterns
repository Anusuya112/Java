public class Pattern23 {
    public static void main(String[] args) {

        int n = 3;

        for (int i = 1; i <= n; i++) {

            // Left spaces
            for (int j = 1; j <= n - i; j++)
                System.out.print(" ");

            System.out.print("*");

            // Left gap
            for (int j = 1; j <= 2 * i - 1; j++)
                System.out.print(" ");

            System.out.print("*");

            // Middle gap
            for (int j = 1; j <= 2 * (n - i); j++)
                System.out.print(" ");

            if (i != 1) {
                System.out.print("*");

                for (int j = 1; j <= 2 * i - 1; j++)
                    System.out.print(" ");

                System.out.print("*");
            }

            System.out.println();
        }
    }
}

