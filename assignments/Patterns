public class Pattern27 {
    public static void main(String[] args) {

        int start = 1;
        int end = 20;
        int rows = 4;

        for (int i = rows; i >= 1; i--) {

            for (int s = 0; s < rows - i; s++)
                System.out.print("  ");

            int temp = start;

            for (int j = 1; j <= i; j++)
                System.out.print(temp++ + " ");

            int right = end - i + 1;

            for (int j = right; j <= end; j++)
                System.out.print(j + " ");

            start += i;
            end -= i;

            System.out.println();
        }
    }
}

