2.Question:
Parameterized Constructor

Program:
class Anusuya{

    String name;
    int id;

    Anusuya(String name, int id)
    {
        this.name = name;
        this.id = id;
    }

    void display(){
        
        System.out.println("AnusuyasName: " + name
                           + " and AnusuyasId: " + id);
    }

    public static void main(String[] args){
        
        Anusuya Anusuyas1 = new Anusuya("Anusuya", 187);
        Anusuyas1.display();
    }
}

Output
AnusuyasName: Anusuya and AnusuyasId: 187

3. Question:
Copy Constructor in Java

Program:
import java.io.*;

class Student {

    String name;
    int id;

    Student(String name, int id) {
        this.name = name;
        this.id = id;
    }

    Student(Student obj2) {
        this.name = obj2.name;
        this.id = obj2.id;
    }

    public static void main(String[] args) {

        System.out.println("First Object");
        Student student1 = new Student("Anusuya", 187);
        System.out.println("Student Name: " + student1.name +
                " and Student ID: " + student1.id);

        System.out.println();

        System.out.println("Copy Constructor used for Second Object");
        Student student2 = new Student(student1);
        System.out.println("Student Name: " + student2.name +
                " and Student ID: " + student2.id);
    }
}

Output:
First Object
Student Name: Anusuya and Student ID: 187

Copy Constructor used for Second Object
Student Name: Anusuya and Student ID: 187
